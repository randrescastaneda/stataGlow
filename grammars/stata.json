{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Stata",
  "scopeName": "source.stata",
  "fileTypes": ["do", "ado", "mata"],
  "foldingStartMarker": "\\{\\s*$",
  "foldingStopMarker": "^\\s*\\}",
  "patterns": [
    {
      "comment": "Official Stata commands (Stata 19)",
      "match": "\\b(arfima|assertnested|bayes|bayesfcast|bayesgraph|bayesirf|bayesmh|bayesselect|bayesvarstable|bcal|betareg|bicplot|bmaregress|candisc|cate|categraph|cfprobit|cfregress|changeeol|churdle|ciwidth|cmclogit|cmmixlogit|cmmprobit|cmrologit|cmroprobit|cmxtmixlogit|coefpath|collect|concordance|contrast|cpoisson|cvplot|demandsys|dfactor|didregress|discrim|dsge|dsgenl|dslogit|dspoisson|dsregress|dtable|dyngen|eintreg|elasticnet|eoprobit|eprobit|eregress|etable|eteffects|etpoisson|etregress|exlogistic|expoisson|fmm|fracreg|frame|frames|frget|frlink|gencohort|gmm|grmap|gsbounds|gsdesign|gsem|h2oml|h2omlgraph|h2omltree|hdidregress|heckoprobit|heckpoisson|heckprobit|hetoprobit|hetprobit|hetregress|icd10|icd10cm|icd10pcs|insobs|irt|irtgraph|ivfprobit|ivlpirf|ivpoisson|ivqregress|jdbc|lasso|latebalance|lateffects|lateoverlap|lpirf|lpoly|margins|marginsplot|mca|mecloglog|mediate|meglm|meintreg|melogit|menbreg|menl|meologit|meoprobit|mepoisson|meprobit|mestreg|meta|metobit|mixed|mlexp|mswitch|mvtest|nlsur|npgraph|npregress|poivregress|pologit|popoisson|poregress|power|psdensity|putexcel|putmata|pwcompare|pwmean|reri|rocreg|sem|snapshot|spivregress|splitsample|spregress|spxtregress|sqrtlasso|sspace|stcrreg|stintcox|stintreg|stmgintcox|stteffects|tebalance|teffects|telasso|teoverlap|threshold|tnbreg|tpoisson|ucm|unicode|varmanage|vl|wildbootstrap|xpoivregress|xpologit|xpopoisson|xporegress|xtdidregress|xtdpd|xtdpdsys|xteintreg|xteoprobit|xteprobit|xteregress|xthdidregress|xtheckman|xtmlogit|xtologit|xtoprobit|xtstreg|xtvar|ziologit|zioprobit|zipfile)\\b",
      "name": "keyword.command.official.stata"
    },
    { "include": "#comments" },
    { "include": "#constants" },
    { "include": "#functions" },
    { "include": "#subscripts" },
    { "include": "#operators" },
    { "include": "#macro-local" },
    { "include": "#macro-global" },
    { "include": "#string-compound" },
    { "include": "#string-regular" },
    { "include": "#macro-commands" },
    { "include": "#factorvariables" },
    { "include": "#control-flow" },
    { "include": "#prefixes" },
    { "include": "#builtin-commands" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "include": "#comments-double-slash" },
        { "include": "#comments-star" },
        { "include": "#comments-block" },
        { "include": "#comments-triple-slash" }
      ]
    },
    "comments-block": {
      "patterns": [
        {
          "begin": "/\\*",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.begin.stata" }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": { "name": "punctuation.definition.comment.end.stata" }
          },
          "name": "comment.block.stata",
          "patterns": [
            { "include": "#comments-block" }
          ]
        }
      ]
    },
    "comments-star": {
      "patterns": [
        {
          "begin": "^\\s*(\\*)",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.stata" }
          },
          "end": "(?=\\n)",
          "name": "comment.line.star.stata",
          "patterns": [
            {
              "begin": "///",
              "end": "\\n",
              "name": "comment.line-continuation.stata"
            }
          ]
        }
      ]
    },
    "comments-triple-slash": {
      "patterns": [
        {
          "begin": "(^///|(?<=\\s)///)",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.stata" }
          },
          "end": "(?=\\n)",
          "name": "comment.line.triple-slash.stata"
        }
      ]
    },
    "comments-double-slash": {
      "patterns": [
        {
          "begin": "(^//|(?<=\\s)//)(?!/)",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.stata" }
          },
          "end": "(?=\\n)",
          "name": "comment.line.double-slash.stata"
        }
      ]
    },
    "constants": {
      "patterns": [
        { "include": "#factorvariables" },
        {
          "match": "\\b(?i:(\\d+\\.\\d*(e[\\-\\+]?\\d+)?))(?=[^a-zA-Z_])",
          "name": "constant.numeric.float.stata"
        },
        {
          "match": "(?<=[^0-9a-zA-Z_])(?i:(\\.\\d+(e[\\-\\+]?\\d+)?))",
          "name": "constant.numeric.float.stata"
        },
        {
          "match": "\\b(?i:(\\d+e[\\-\\+]?\\d+))",
          "name": "constant.numeric.float.stata"
        },
        {
          "match": "\\b(\\d+)\\b",
          "name": "constant.numeric.integer.decimal.stata"
        },
        {
          "match": "(?<![\\w])(\\.(?![\\./]))(?![\\w])",
          "name": "constant.language.missing.stata"
        },
        {
          "match": "\\b_all\\b",
          "name": "constant.language.allvars.stata"
        }
      ]
    },
    "factorvariables": {
      "patterns": [
        {
          "match": "\\b(i|c|o)\\.(?=[a-zA-Z_]|\\([a-zA-Z_])",
          "name": "constant.language.factorvars.stata"
        },
        {
          "match": "\\b(i?b)((\\d+)|n)\\.(?=[a-zA-Z_]|\\([a-zA-Z_])",
          "name": "constant.language.factorvars.stata"
        },
        {
          "match": "\\b(i?b)(\\()(#\\d+|first|last|freq)(\\))\\.(?=[a-zA-Z_]|\\([a-zA-Z_])",
          "name": "constant.language.factorvars.stata"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "begin": "\\b((abbrev|abs|acos|acosh|asin|asinh|atan|atan2|atanh|autocode|betaden|binomial|binomialp|binomialtail|byteorder|c|cauchy|cauchyden|cauchytail|ceil|char|chi2|chi2den|chi2tail|cholesky|chop|clip|clock|Clock|cloglog|coleqnumb|collatorlocale|collatorversion|colnfreeparms|colnumb|colsof|comb|cond|corr|cos|cosh|daily|date|day|det|dhms|diag|diag0cnt|digamma|dofb|dofc|dofh|dofm|dofq|dofw|dofy|dow|doy|dunnettprob|e|el|epsdouble|epsfloat|exp|exponential|exponentialden|exponentialtail|F|Fden|fileexists|fileread|filereaderror|filewrite|float|floor|fmtwidth|Ftail|gammaden|gammap|gammaptail|get|hadamard|halfyear|halfyearly|hh|hms|hofd|hours|hypergeometric|hypergeometricp|I|ibeta|ibetatail|igaussian|igaussianden|igaussiantail|indexnot|inlist|inrange|int|inv|invbinomial|invbinomialtail|invcauchy|invcauchytail|invchi2|invchi2tail|invcloglog|invdunnettprob|invexponential|invexponentialtail|invF|invFtail|invgammap|invgammaptail|invibeta|invibetatail|invigaussian|invigaussiantail|invlaplace|invlaplacetail|invlogistic|invlogistictail|invlogit|invnbinomial|invnbinomialtail|invnchi2|invnchi2tail|invnF|invnFtail|invnibeta|invnormal|invnt|invnttail|invpoisson|invpoissontail|invsym|invt|invttail|invtukeyprob|invweibull|invweibullph|invweibullphtail|invweibulltail|irecode|issymmetric|itrim|J|laplace|laplaceden|laplacetail|length|ln|lncauchyden|lnfactorial|lngamma|lnigammaden|lnigaussianden|lniwishartden|lnlaplaceden|lnmvnormalden|lnnormal|lnnormalden|lnwishartden|log|log10|logistic|logisticden|logistictail|logit|lower|ltrim|matmissing|matrix|matuniform|max|maxbyte|maxdouble|maxfloat|maxint|maxlong|mdy|mdyhms|mi|min|minbyte|mindouble|minfloat|minint|minlong|minutes|missing|mm|mod|mofd|month|monthly|mreldif|msofhours|msofminutes|msofseconds|nbetaden|nbinomial|nbinomialp|nbinomialtail|nchi2|nchi2den|nchi2tail|nF|nFden|nFtail|nibeta|normal|normalden|npnchi2|npnF|npnt|nt|ntden|nttail|nullmat|plural|poisson|poissonp|poissontail|proper|qofd|quarter|quarterly|r|rbeta|rbinomial|rcauchy|rchi2|real|recode|regexm|regexr|regexs|reldif|replay|return|reverse|rexponential|rgamma|rhypergeometric|rigaussian|rlaplace|rlogistic|rnbinomial|rnormal|round|roweqnumb|rownfreeparms|rownumb|rowsof|rpoisson|rt|rtrim|runiform|runiformint|rweibull|rweibullph|s|scalar|seconds|sign|sin|sinh|smallestdouble|soundex|sqrt|ss|string|stritrim|strlen|strlower|strltrim|strmatch|strofreal|strpos|strproper|strreverse|strrpos|strrtrim|strtoname|strtrim|strupper|subinstr|subinword|substr|sum|sweep|t|tan|tanh|tc|tC|td|tden|th|tin|tm|tobytes|tq|trace|trigamma|trim|trunc|ttail|tukeyprob|tw|twithin|uchar|udstrlen|udsubstr|uisdigit|uisletter|upper|ustrcompare|ustrcompareex|ustrfix|ustrfrom|ustrinvalidcnt|ustrleft|ustrlen|ustrlower|ustrltrim|ustrnormalize|ustrpos|ustrregexm|ustrregexra|ustrregexrf|ustrregexs|ustrreverse|ustrright|ustrrpos|ustrrtrim|ustrsortkey|ustrsortkeyex|ustrtitle|ustrto|ustrtohex|ustrtoname|ustrtrim|ustrunescape|ustrupper|ustrword|ustrwordcount|usubinstr|usubstr|vec|vecdiag|week|weekly|weibull|weibullden|weibullph|weibullphden|weibullphtail|weibulltail|wofd|word|wordbreaklocale|wordcount|year|yearly|yh|ym|yofd|yq|yw))(\\()",
          "beginCaptures": {
            "2": { "name": "support.function.builtin.stata" },
            "3": { "name": "punctuation.definition.parameters.begin.stata" }
          },
          "end": "(\\))",
          "endCaptures": {
            "1": { "name": "punctuation.definition.parameters.end.stata" }
          },
          "patterns": [
            { "include": "#functions" },
            { "include": "#constants" },
            { "include": "#operators" },
            { "include": "#macro-local" },
            { "include": "#macro-global" },
            { "include": "#string-compound" },
            { "include": "#string-regular" }
          ]
        }
      ]
    },
    "macro-commands": {
      "patterns": [
        {
          "begin": "\\b(loc(al|a)?)\\s+",
          "beginCaptures": {
            "1": { "name": "keyword.macro.stata" }
          },
          "end": "(?=\\n|//|/\\*)",
          "patterns": [
            { "include": "#macro-local" },
            { "include": "#macro-global" },
            { "include": "#operators" },
            { "include": "#string-compound" },
            { "include": "#string-regular" },
            { "include": "#constants" }
          ]
        },
        {
          "begin": "\\b(gl(obal|oba|ob|o)?)\\s+",
          "beginCaptures": {
            "1": { "name": "keyword.macro.stata" }
          },
          "end": "(?=\\n|//|/\\*)",
          "patterns": [
            { "include": "#macro-local" },
            { "include": "#macro-global" },
            { "include": "#operators" },
            { "include": "#string-compound" },
            { "include": "#string-regular" },
            { "include": "#constants" }
          ]
        },
        {
          "begin": "\\b(tempvar|tempname|tempfile)\\s+",
          "beginCaptures": {
            "1": { "name": "keyword.macro.stata" }
          },
          "end": "(?=\\n|//|/\\*)",
          "patterns": [
            {
              "match": "\\w{1,31}",
              "name": "entity.name.type.class.stata"
            }
          ]
        }
      ]
    },
    "macro-local": {
      "patterns": [
        {
          "begin": "`(?!\")",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.variable.begin.stata" }
          },
          "end": "'",
          "endCaptures": {
            "0": { "name": "punctuation.definition.variable.end.stata" }
          },
          "name": "variable.other.local.stata",
          "patterns": [
            {
              "match": "\\+\\+|\\-\\-",
              "name": "keyword.operator.arithmetic.stata"
            },
            { "include": "#macro-local" },
            { "include": "#macro-global" },
            {
              "match": "\\w{1,31}",
              "name": "entity.name.variable.local.stata"
            }
          ]
        }
      ]
    },
    "macro-global": {
      "patterns": [
        {
          "begin": "\\$\\{",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.variable.begin.stata" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.definition.variable.end.stata" }
          },
          "name": "variable.other.global.stata",
          "patterns": [
            { "include": "#macro-local" },
            { "include": "#macro-global" },
            {
              "match": "\\w{1,32}",
              "name": "entity.name.variable.global.stata"
            }
          ]
        },
        {
          "begin": "\\$(?=[a-zA-Z_])",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.variable.begin.stata" }
          },
          "end": "(?![\\w])",
          "name": "variable.other.global.stata",
          "patterns": [
            { "include": "#macro-local" },
            { "include": "#macro-global" },
            {
              "match": "[a-zA-Z_]\\w{0,31}",
              "name": "entity.name.variable.global.stata"
            }
          ]
        }
      ]
    },
    "string-compound": {
      "patterns": [
        {
          "begin": "`\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.stata" }
          },
          "end": "\"'|(?=\\n)",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.stata" }
          },
          "name": "string.quoted.double.compound.stata",
          "patterns": [
            { "include": "#string-regular" },
            { "include": "#string-compound" },
            { "include": "#macro-local" },
            { "include": "#macro-global" }
          ]
        }
      ]
    },
    "string-regular": {
      "patterns": [
        {
          "begin": "(?<!`|`)\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.stata" }
          },
          "end": "\"|(?=\\n)",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.stata" }
          },
          "name": "string.quoted.double.stata",
          "patterns": [
            { "include": "#macro-local" },
            { "include": "#macro-global" }
          ]
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "match": "\\+\\+|\\-\\-|\\+|\\-|\\*|\\^",
          "name": "keyword.operator.arithmetic.stata"
        },
        {
          "match": "(?<![\\w.])/(?![\\w.]|$)",
          "name": "keyword.operator.arithmetic.stata"
        },
        {
          "match": "\\&|\\|",
          "name": "keyword.operator.logical.stata"
        },
        {
          "match": "(?:<=|>=|:=|==|!=|~=|<|>|=|!)",
          "name": "keyword.operator.comparison.stata"
        },
        {
          "match": "\\(|\\)",
          "name": "keyword.operator.parentheses.stata"
        },
        {
          "match": "(##|#)",
          "name": "keyword.operator.factor-variables.stata"
        },
        {
          "match": "%",
          "name": "keyword.operator.format.stata"
        },
        {
          "match": ":",
          "name": "punctuation.separator.key-value"
        },
        {
          "match": "\\[",
          "name": "punctuation.definition.parameters.begin.stata"
        },
        {
          "match": "\\]",
          "name": "punctuation.definition.parameters.end.stata"
        },
        {
          "match": ",",
          "name": "punctuation.separator.stata"
        },
        {
          "match": ";",
          "name": "keyword.operator.delimiter.stata"
        }
      ]
    },
    "subscripts": {
      "patterns": [
        {
          "begin": "(?<=[\\w'])(\\[)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.parameters.begin.stata" }
          },
          "end": "(\\])",
          "endCaptures": {
            "1": { "name": "punctuation.definition.parameters.end.stata" }
          },
          "name": "meta.subscripts.stata",
          "patterns": [
            {
              "match": "\\b(\\d*)(\\.\\.\\.|\\.\\.)\\b",
              "name": "constant.language.matrix_row.stata"
            },
            { "include": "#macro-local" },
            { "include": "#macro-global" },
            { "include": "#operators" },
            { "include": "#constants" },
            { "include": "#functions" },
            {
              "match": "_n|_N",
              "name": "variable.language.stata"
            }
          ]
        }
      ]
    },
    "control-flow": {
      "patterns": [
        {
          "match": "\\b(if|else if|else)\\b",
          "name": "keyword.control.conditional.stata"
        },
        {
          "match": "\\b(foreach|forvalues|forvalue|forvalu|forval|forva|forv)\\b",
          "name": "keyword.control.flow.stata"
        },
        {
          "match": "\\b(while|continue|break)\\b",
          "name": "keyword.control.flow.stata"
        },
        {
          "match": "\\b(in|of)\\b",
          "name": "keyword.control.flow.stata"
        }
      ]
    },
    "prefixes": {
      "patterns": [
        {
          "match": "\\b(by(sort|sor|so|s)?|statsby|rolling|bootstrap|jackknife|permute|simulate|svy|mi est(imate|imat|ima|im|i)?|nestreg|stepwise|xi|fp|mfp|vers(ion|io|i)?)\\b",
          "name": "storage.type.function.stata"
        },
        {
          "match": "\\b(qui(etly|etl|et|e)?|n(oisily|oisil|oisi|ois|oi|o)?|cap(ture|tur|tu|t)?)\\b:?",
          "name": "keyword.control.flow.stata"
        }
      ]
    },
    "builtin-commands": {
      "patterns": [
        {
          "match": "\\b(sa(v|ve)|saveold|destring|tostring|u(se|s)?|note(s)?|form(at|a)?)\\b",
          "name": "keyword.functions.data.stata"
        },
        {
          "match": "\\b(exit|end)\\b",
          "name": "keyword.functions.data.stata"
        },
        {
          "match": "\\b(g(enerate|enerat|enera|ener|ene|en|e)?|egen)\\b",
          "name": "keyword.functions.data.stata"
        },
        {
          "match": "\\b(replace)\\b",
          "name": "keyword.functions.data.stata"
        },
        {
          "match": "\\b(drop|keep)\\b",
          "name": "keyword.functions.data.stata"
        },
        {
          "match": "\\b(sort|gsort|order)\\b",
          "name": "keyword.functions.data.stata"
        },
        {
          "match": "\\b(mer(ge|g)?)\\b",
          "name": "keyword.control.flow.stata"
        },
        {
          "match": "\\b(reshape)\\b",
          "name": "keyword.functions.data.stata"
        },
        {
          "match": "\\b(display|di)\\b",
          "name": "keyword.functions.data.stata"
        },
        {
          "match": "\\b(summarize|sum|su)\\b",
          "name": "keyword.functions.data.stata"
        },
        {
          "match": "\\b(describe|des|de)\\b",
          "name": "keyword.functions.data.stata"
        },
        {
          "match": "\\b(list|li|l)\\b",
          "name": "keyword.functions.data.stata"
        },
        {
          "match": "\\b(tabulate|tab|ta)\\b",
          "name": "keyword.functions.data.stata"
        },
        {
          "match": "\\b(regress|reg|regr)\\b",
          "name": "keyword.functions.data.stata"
        },
        {
          "match": "\\b(logit|logistic|probit)\\b",
          "name": "keyword.functions.data.stata"
        },
        {
          "match": "\\b(anova|manova)\\b",
          "name": "keyword.functions.data.stata"
        },
        {
          "match": "\\b(correlate|corr|pwcorr)\\b",
          "name": "keyword.functions.data.stata"
        },
        {
          "match": "\\b(ttest|ttesti)\\b",
          "name": "keyword.functions.data.stata"
        },
        {
          "match": "\\b(la(bel|be|b)?)\\b",
          "name": "keyword.functions.data.stata"
        },
        {
          "match": "\\b(sca(lar|la|l)?)\\b",
          "name": "storage.type.scalar.stata"
        },
        {
          "match": "\\b(mat(rix|ri|r)?)\\b",
          "name": "storage.type.matrix.stata"
        },
        {
          "match": "\\b(pr(ogram|ogra|ogr|og|o)?)\\b",
          "name": "storage.type.function.stata"
        },
        {
          "match": "\\b(as|ass|asse|asser|assert)\\b",
          "name": "keyword.other.stata"
        },
        {
          "match": "\\b(confirm)\\b",
          "name": "keyword.other.stata"
        },
        {
          "match": "\\b(set|clear|cd|pwd|log|using)\\b",
          "name": "keyword.functions.data.stata"
        },
        {
          "match": "\\b(sysuse|webuse|import|export)\\b",
          "name": "keyword.functions.data.stata"
        },
        {
          "match": "\\b(graph|gr|twoway|histogram|scatter|line)\\b",
          "name": "keyword.functions.data.stata"
        },
        {
          "match": "\\b(est(imates|imate|imat|ima|im|i)?|est(store|tab|out))\\b",
          "name": "keyword.functions.data.stata"
        },
        {
          "match": "\\b(syntax|args|return|ereturn|sreturn)\\b",
          "name": "keyword.functions.program.stata"
        },
        {
          "match": "\\b(predict|test|testnl|lincom|nlcom|margins)\\b",
          "name": "keyword.functions.data.stata"
        },
        {
          "match": "\\b(xtset|tsset|stset|svyset)\\b",
          "name": "keyword.functions.data.stata"
        },
        {
          "match": "\\b(xtabond|xtreg|xtregar|xtlogit|xtprobit|xtpoisson|xtnbreg|xtgee|xtmixed|xtivreg)\\b",
          "name": "keyword.functions.data.stata"
        },
        {
          "match": "\\b(tsline|tssmooth|arch|arima|arfima|var|vec|irf|fcast|varsoc|varlmar)\\b",
          "name": "keyword.functions.data.stata"
        },
        {
          "match": "\\b(streg|stcox|sts|stsum|stdes|stgen|stvary|stptime|ltable)\\b",
          "name": "keyword.functions.data.stata"
        }
      ]
    }
  }
}
