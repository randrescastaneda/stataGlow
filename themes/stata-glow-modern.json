{
  "name": "StataGlow Modern",
  "type": "dark",
  "colors": {
    "editor.background": "#0d1117",
    "editor.foreground": "#c9d1d9",
    "editor.lineNumberActiveBackground": "#30363d",
    "editor.lineNumberForeground": "#6e7681",
    "editor.selectionBackground": "#388bfd33",
    "editorCursor.foreground": "#58a6ff",
    "editorWhitespace.foreground": "#6e768166"
