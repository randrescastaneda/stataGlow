        "fontStyle": "bold"
      }
    },
    {
      "scope": "keyword.control.flow.prefix.stata",
      "settings": {
        "foreground": "#005cc5",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "keyword.other.extended-macro.stata",
      "settings": {
        "foreground": "#6f42c1",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "constant.numeric.stata",
      "settings": {
        "foreground": "#005cc5"
      }
    },
    {
      "scope": "constant.numeric.float.stata",
