{
  "name": "StataGlow Light",
  "type": "light",
  "colors": {
    "editor.background": "#ffffff",
    "editor.foreground": "#24292e",
    "editor.lineHighlightBackground": "#f6f8fa",
    "editor.lineNumberActiveBackground": "#e1e4e8",
    "editor.lineNumberForeground": "#959da5",
    "editor.selectionBackground": "#c8e1ff",
    "editorCursor.foreground": "#044289",
    "editorWhitespace.foreground": "#d1d5da"
  },
  "tokenColors": [
    {
      "scope": "comment",
      "settings": {
        "foreground": "#6a737d",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "keyword.command.official.stata",
      "settings": {
        "foreground": "#005cc5"
      }
    },
    {
      "scope": "keyword.functions.data.stata",
      "settings": {
        "foreground": "#005cc5"
      }
    },
    {
      "scope": "keyword.command.community.stata",
      "settings": {
        "foreground": "#005cc5",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "keyword.command.custom.stata",
      "settings": {
        "foreground": "#6f42c1",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "support.function.builtin.stata",
      "settings": {
        "foreground": "#6f42c1"
      }
    },
    {
      "scope": "variable.other.macro.local.stata",
      "settings": {
        "foreground": "#e36209"
      }
    },
    {
      "scope": "variable.other.macro.global.stata",
      "settings": {
        "foreground": "#e36209",
        "fontStyle": "bold"
      }
    },
    {
