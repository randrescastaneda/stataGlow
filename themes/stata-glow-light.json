      "settings": {
        "foreground": "#032f62"
      }
    },
    {
      "scope": "string.quoted.double.compound.stata",
      "settings": {
        "foreground": "#032f62",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "keyword.operator.arithmetic.stata",
      "settings": {
        "foreground": "#d73a49",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "keyword.operator.comparison.stata",
      "settings": {
        "foreground": "#d73a49"
      }
    },
    {
      "scope": "keyword.operator.logical.stata",
      "settings": {
        "foreground": "#d73a49"
      }
    },
    {
      "scope": "keyword.operator.macro.stata",
      "settings": {
        "foreground": "#d73a49",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "keyword.control.conditional.stata",
